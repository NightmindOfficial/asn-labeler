PAPERLESS_URL=http://paperless:8000
PAPERLESS_TOKEN=replace-with-paperless-token
ASN_PREFIX=ASN
ASN_PADDING=5
API_KEYS=replace-with-at-least-32-random-characters-per-client
ADMIN_API_KEYS=replace-with-a-different-random-admin-key-at-least-32-characters
RESERVATION_TTL_SECONDS=300
# In Druck until this confirmation deadline; then Druck unklar, never automatic reuse.
# Minimum 10 seconds. This does not cancel a still-running printer job.
PRINTING_SETTLE_SECONDS=30
# Require a newer client for security fixes. Cannot lower the release floor (2.0.0).
# Restart/redeploy after changing; publish/install the required client first.
MINIMUM_CLIENT_VERSION=2.0.0
SQLITE_PATH=/data/reservations.sqlite3
LISTEN_ADDR=0.0.0.0
PORT=8765
# Set the actual NAS LAN IP only when LAN emergency access is needed.
NAS_BIND_IP=127.0.0.1
